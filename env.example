# Free Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: which Groq model to use (free tier)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: protect your own endpoint from public misuse.
# If set, every request to /api/generate must include header: x-api-key: <this value>
MY_API_KEY=choose_a_random_secret_string

# Render sets PORT automatically, no need to set it yourself
